# F2Apps Docker Environment Configuration
# ========================================
#
# Copy this file to .env.docker and configure your values
# Usage: docker compose --env-file .env.docker up -d

# ===========================================
# User Configuration
# ===========================================
# Match these with your host user to avoid permission issues
# Get your values with: id -u && id -g
USER_ID=1000
GROUP_ID=1000

# ===========================================
# Application Environment
# ===========================================
APP_ENV=local
APP_DEBUG=true

# ===========================================
# Domain Configuration
# ===========================================
# Local development domains
SAAS_DOMAIN=hourledger.local.com
CUSTOMER_APP_DOMAIN=app.hourledger.local.com
BACKOFFICE_DOMAIN=admin.hourledger.local.com
API_DOMAIN=api.hourledger.local.com

# Full URLs (used in production)
SAAS_URL=http://hourledger.local.com
CUSTOMER_APP_URL=http://app.hourledger.local.com
BACKOFFICE_URL=http://admin.hourledger.local.com
API_URL=http://api.hourledger.local.com

# ===========================================
# Port Configuration
# ===========================================
# Nginx ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Direct access ports (for debugging)
FRONTEND_PORT=5173
LANDINGPAGE_PORT=3000
BACKOFFICE_PORT=3001

# Database ports
POSTGRES_PORT=5432
REDIS_PORT=6379

# ===========================================
# PostgreSQL Configuration
# ===========================================
POSTGRES_USER=f2apps
POSTGRES_PASSWORD=f2apps_secret_change_in_production
POSTGRES_DB=f2apps

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PASSWORD=f2apps_redis_change_in_production

# ===========================================
# Laravel Application Configuration
# ===========================================
# These can also be set in backend/.env
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_URL=http://api.hourledger.local.com

# ===========================================
# Production-Only Variables
# ===========================================
# Uncomment and configure for production
# APP_ENV=production
# APP_DEBUG=false
#
# SAAS_DOMAIN=hourledger.local.com
# CUSTOMER_APP_DOMAIN=app.hourledger.local.com
# BACKOFFICE_DOMAIN=admin.hourledger.local.com
# API_DOMAIN=api.hourledger.local.com
#
# SAAS_URL=https://hourledger.local.com
# CUSTOMER_APP_URL=https://app.hourledger.local.com
# BACKOFFICE_URL=https://admin.hourledger.local.com
# API_URL=https://api.hourledger.local.com
