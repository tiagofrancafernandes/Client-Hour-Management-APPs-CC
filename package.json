{
    "type": "module",
    "scripts": {
        "docker": "docker-compose --env-file .env.docker --profile default",
        "dk:ps": "npm run docker -- ps",
        "dk:stop": "npm run docker -- stop",
        "dk:exec": "npm run docker -- exec",
        "dk:up": "docker-compose --env-file .env.docker --profile default up",
        "dk:down": "docker-compose --env-file .env.docker --profile default down",
        "dk:recreate": "npm run dk:down && npm run dk:up",
        "dev": "npm run dk:up",
        "open-in-editor-server": "node frontend/open-in-editor-server.js",
        "start": "npm run dk:up"
    },
    "devDependencies": {
        "vue-eslint-parser": "^10.4.0"
    }
}
