{
    "type": "module",
    "scripts": {
        "concurrently": "npx -y concurrently",
        "concurrently:demo:1": "npx -y concurrently -n php1,php2 -c blue,green \"npm:dev:php1\" \"npm:dev:php2\"",
        "dev:php1": "php -S 0.0.0.0:8004 _info.php",
        "dev:php2": "php -S 0.0.0.0:8005 _info.php",
        "docker": "docker-compose --env-file .env.docker --profile default",
        "dk:ps": "npm run docker -- ps",
        "dk:stop": "npm run docker -- stop",
        "dk:exec": "npm run docker -- exec",
        "dk:up": "docker-compose --env-file .env.docker --profile default up",
        "dk:down": "docker-compose --env-file .env.docker --profile default down",
        "dk:recreate": "npm run dk:down && npm run dk:up",
        "old:dev": "npm run dk:up",
        "dev": "npx -y concurrently -n docker,openineditor -c blue,green \"npm:dk:up\" \"npm:open-in-editor-server\"",
        "open-in-editor-server": "node frontend/open-in-editor-server.js",
        "dev:open-in-editor-server": "node frontend/open-in-editor-server.js",
        "start": "npm run dk:up"
    },
    "devDependencies": {
        "vue-eslint-parser": "^10.4.0"
    }
}
